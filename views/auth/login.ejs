<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion — ORMVA Souss Massa</title>
    <link
      rel="stylesheet"
      href="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\css\login.css"
    />
  </head>
  <body>
    <div class="card">
      <!-- LEFT: brand panel -->
      <div class="panel-left">
        <svg class="network" viewBox="0 0 500 500" preserveAspectRatio="none">
          <g stroke="#ffffff" stroke-width="1" opacity="0.5">
            <line x1="20" y1="470" x2="180" y2="330" />
            <line x1="180" y1="330" x2="330" y2="380" />
            <line x1="330" y1="380" x2="470" y2="230" />
            <line x1="180" y1="330" x2="120" y2="200" />
            <line x1="330" y1="380" x2="250" y2="460" />
          </g>
          <g fill="#ffffff">
            <circle cx="20" cy="470" r="5" />
            <circle cx="180" cy="330" r="5" />
            <circle cx="330" cy="380" r="5" />
            <circle cx="470" cy="230" r="5" />
            <circle cx="120" cy="200" r="5" />
            <circle cx="250" cy="460" r="5" />
          </g>
        </svg>

        <div class="logo-badge">
          <img
            src="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\img\LOGO_OMRVASM.png"
            alt="Logo ORMVA Souss Massa"
            style="
              width: 100%;
              height: 100%;
              object-fit: contain;
              border-radius: 16px;
            "
          />
        </div>

        <div class="eyebrow">ORMVA Souss Massa</div>
        <br />
        <h1>
          Application de Gestion des Appels d'Offres<br />et des Marchés
          Informatiques
        </h1>
        <br />

        <div class="badges">
          <span class="badge"> Accès sécurisé </span>
          <span class="badge">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 2 2 7v2h20V7L12 2zM4 10v9H2v2h20v-2h-2v-9h-2v9h-3v-9h-2v9h-3v-9H6v9H4v-9H4z"
              />
            </svg>
            Administration publique
          </span>
        </div>
      </div>

      <!-- RIGHT: login form -->
      <div class="panel-right">
        <div class="org-logo">
          <img
            src="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\img\LOGO_OMRVASM.png"
            alt="Logo ORMVA Souss Massa"
            style="
              width: 100%;
              height: 100%;
              object-fit: contain;
              border-radius: 16px;
            "
          />
        </div>

        <h2>Connexion</h2>
        <p class="subtitle">
          Veuillez vous authentifier pour accéder au système.
        </p>

        <div class="error-msg" id="errorMsg">
          Nom d'utilisateur ou mot de passe incorrect.
        </div>

        <form id="loginForm" novalidate>
          <label for="email">Email</label>
          <div class="field">
            <svg class="icon-left" viewBox="0 0 24 24">
              <path
                d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM4 22a8 8 0 0 1 16 0"
              />
            </svg>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="admin@ormvasm.ma"
              autocomplete="email"
              required
            />
          </div>

          <label for="password">Mot de passe</label>
          <div class="field">
            <svg class="icon-left" viewBox="0 0 24 24">
              <rect x="5" y="11" width="14" height="9" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
            <button
              type="button"
              class="toggle-eye"
              id="togglePass"
              aria-label="Afficher le mot de passe"
            >
              <svg viewBox="0 0 24 24">
                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>

          <div class="row-between">
            <a href="#" id="forgotLink">Mot de passe oublié ?</a>
          </div>

          <button type="submit" class="submit" id="loginBtn">
            <span id="btnText">Se connecter</span>
          </button>
        </form>

        <footer>© 2026 ORMVA Souss Massa<br /></footer>
      </div>
    </div>

    <script
      src="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\js\login.js"
    >
     
    </script>
  </body>
</html>
