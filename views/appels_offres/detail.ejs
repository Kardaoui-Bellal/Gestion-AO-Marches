<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : appelOffre.numero_ao %> — ORMVA/SM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/Layout/sidebar.css" />
    <link rel="stylesheet" href="/css/Layout/navbar.css" />
    <link rel="stylesheet" href="/css/Layout/footer.css" />
    <link rel="stylesheet" href="/css/appels-offres-detail.css" />
  </head>
  <body>
    <%
      function fmtDate(v) {
        if (!v) return '—';
        const d = new Date(v);
        if (isNaN(d)) return '—';
        return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
      }
      function fmtMoney(v) {
        if (v === null || v === undefined || v === '') return '—';
        return Number(v).toLocaleString('fr-FR') + ' DH';
      }
      function etatBadgeClass(code) {
        switch (code) {
          case 'BROUILLON': return 'neutral';
          case 'PUBLIE':
          case 'OUVERTURE_PLIS': return 'info';
          case 'EN_EVALUATION': return 'warning';
          case 'ATTRIBUE': return 'success';
          case 'INFRUCTUEUX': return 'warning';
          case 'ANNULE': return 'danger';
          default: return 'neutral';
        }
      }
      function offreStatutBadgeClass(code) {
        switch (code) {
          case 'RECUE': return 'neutral';
          case 'ADMISSIBLE': return 'info';
          case 'RETENUE': return 'success';
          case 'REJETEE': return 'danger';
          default: return 'neutral';
        }
      }
      function checklistBadgeClass(code) {
        switch (code) {
          case 'TODO': return 'neutral';
          case 'WIP': return 'info';
          case 'DONE': return 'success';
          case 'BLOCKED': return 'danger';
          case 'NA': return 'neutral';
          default: return 'neutral';
        }
      }
      function fmtSize(bytes) {
        if (!bytes) return '';
        const kb = bytes / 1024;
        if (kb < 1024) return Math.round(kb) + ' Ko';
        return (kb / 1024).toFixed(1) + ' Mo';
      }
    %>

    <div class="app-shell">
      <%- include('../layouts/partials/sidebar', {
        currentPage: 'appels-offres',
        currentUser: currentUser
      }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', {
          title: "Gestion des Appels d'Offres",
          currentUser: currentUser
        }) %>
    <div class="wrap">
      <a class="back-link" href="/appels-offres">&larr; Retour à la liste</a>

      <div class="topbar">
        <div class="title-block">
          <div class="ref-line">
            <span class="ref"><%= appelOffre.numero_ao %></span>
            <span class="badge <%= etatBadgeClass(appelOffre.etat_code) %>"><%= appelOffre.etat_libelle %></span>
            <span class="badge neutral"><%= appelOffre.categorie_libelle %></span>
          </div>
          <h1><%= appelOffre.objet %></h1>
        </div>
        <div class="actions-top">
          <a class="btn btn-ghost" href="/appels-offres/<%= appelOffre.id_ao %>/edit">Modifier</a>
        </div>
      </div>

      <div class="grid-main">
        <!-- Colonne principale -->
        <div class="col-main">

          <section class="card">
            <h2>Informations générales</h2>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="k">Montant estimatif</div>
                <div class="v mono"><%= fmtMoney(appelOffre.montant_estimatif) %></div>
              </div>
              <div class="detail-item">
                <div class="k">Fournisseur attributaire</div>
                <div class="v"><%= appelOffre.fournisseur_nom || '—' %></div>
              </div>
              <div class="detail-item">
                <div class="k">Date de lancement</div>
                <div class="v mono"><%= fmtDate(appelOffre.date_lancement) %></div>
              </div>
              <div class="detail-item">
                <div class="k">Date limite de dépôt</div>
                <div class="v mono"><%= fmtDate(appelOffre.date_limite_depot) %></div>
              </div>
              <div class="detail-item">
                <div class="k">Ouverture des plis</div>
                <div class="v mono"><%= fmtDate(appelOffre.date_ouverture_plis) %></div>
              </div>
              <div class="detail-item">
                <div class="k">Date d'attribution</div>
                <div class="v mono"><%= fmtDate(appelOffre.date_attribution) %></div>
              </div>
            </div>
            <% if (appelOffre.observation) { %>
              <div class="detail-item full obs">
                <div class="k">Observations</div>
                <div class="v"><%= appelOffre.observation %></div>
              </div>
            <% } %>
          </section>

          <section class="card">
            <div class="card-header">
              <h2>Offres reçues <span class="count"><%= offres.length %></span></h2>
              <a class="btn btn-ghost btn-sm" href="/appels-offres/<%= appelOffre.id_ao %>/offres/new">+ Ajouter une offre</a>
            </div>

            <% if (offres.length === 0) { %>
              <p class="empty-msg">Aucune offre reçue pour le moment.</p>
            <% } else { %>
              <table>
                <thead>
                  <tr>
                    <th>Fournisseur</th>
                    <th>Montant proposé</th>
                    <th>Date de soumission</th>
                    <th>Statut</th>
                    <th style="width:70px"></th>
                  </tr>
                </thead>
                <tbody>
                  <% offres.forEach(function(o) { %>
                    <tr>
                      <td><%= o.fournisseur_nom %></td>
                      <td class="mono"><%= fmtMoney(o.montant_propose) %></td>
                      <td class="mono"><%= fmtDate(o.date_soumission) %></td>
                      <td><span class="badge <%= offreStatutBadgeClass(o.statut_code) %>"><%= o.statut_libelle %></span></td>
                      <td><a class="icon-btn" title="Modifier" href="/offres/<%= o.id_offre %>/edit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                      </a></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } %>
          </section>

          <section class="card">
            <div class="card-header">
              <h2>Documents <span class="count"><%= documents.length %></span></h2>
              <a class="btn btn-ghost btn-sm" href="/documents/upload?type_entite=AO&entite_id=<%= appelOffre.id_ao %>">+ Ajouter un document</a>
            </div>

            <% if (documents.length === 0) { %>
              <p class="empty-msg">Aucun document déposé pour le moment.</p>
            <% } else { %>
              <ul class="doc-list">
                <% documents.forEach(function(d) { %>
                  <li class="doc-item">
                    <div class="doc-info">
                      <div class="doc-name"><%= d.nom_original %></div>
                      <div class="doc-meta">
                        <%= d.type_document_libelle %> · <%= fmtSize(d.taille) %> · déposé le <%= fmtDate(d.date_ajout) %>
                      </div>
                    </div>
                    <div class="doc-actions">
                      <a class="icon-btn" title="Télécharger" href="/documents/<%= d.id_document %>/download">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      </a>
                      <form class="archive-form" method="POST" action="/documents/<%= d.id_document %>/archive">
                        <button class="icon-btn danger" type="submit" title="Archiver">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                        </button>
                      </form>
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </section>

        </div>

        <!-- Colonne latérale -->
        <div class="col-side">
          <section class="card">
            <h2>Checklist</h2>
            <% if (checklist.length === 0) { %>
              <p class="empty-msg">Aucune étape de checklist initialisée.</p>
            <% } else { %>
              <ul class="checklist">
                <% checklist.forEach(function(item) { %>
                  <li class="checklist-item">
                    <span class="badge sm <%= checklistBadgeClass(item.statut_code) %>"><%= item.statut_libelle %></span>
                    <div class="checklist-body">
                      <div class="checklist-label"><%= item.etape_libelle %></div>
                      <% if (item.date_validation) { %>
                        <div class="checklist-date">Validé le <%= fmtDate(item.date_validation) %></div>
                      <% } %>
                      <% if (item.observation) { %>
                        <div class="checklist-obs"><%= item.observation %></div>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              </ul>
              <a class="link-more" href="/checklist/AO/<%= appelOffre.id_ao %>">Voir la checklist complète →</a>
            <% } %>
          </section>
        </div>
      </div>
    </div>
        <%- include('../layouts/partials/footer') %>
      </main>
    </div>

    <div id="toast"></div>
    <script src="/js/appels-offres-detail.js"></script>
  </body>
</html>
