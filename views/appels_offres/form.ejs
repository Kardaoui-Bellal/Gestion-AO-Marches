<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nouvel appel d'offres — ORMVA/SM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6f4ee; --surface:#ffffff; --surface-2:#fbfaf6; --border:#e1ddd2;
  --primary:#1f4b3f; --primary-light:#2d6a5c; --primary-dark:#153730;
  --accent:#c08a2e; --accent-light:#fbf1de;
  --text:#1c231f; --text-muted:#5b6b62; --text-faint:#8b9188;
  --rust:#a6432b; --rust-bg:#f6e4df;
  --radius:10px;
  --shadow:0 1px 2px rgba(28,35,31,.06), 0 4px 16px rgba(28,35,31,.06);
  font-family:'Inter',sans-serif;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{background:var(--bg); color:var(--text); min-height:100vh; line-height:1.5; -webkit-font-smoothing:antialiased;}
.wrap{max-width:820px; margin:0 auto; padding:28px 32px 100px;}

.back-link{
  display:inline-flex; align-items:center; gap:6px; color:var(--text-muted); text-decoration:none;
  font-size:13px; font-weight:600; margin-bottom:18px; transition:color .12s ease;
}
.back-link:hover{color:var(--primary-dark);}

.page-head{display:flex; align-items:center; gap:14px; margin-bottom:26px;}
.head-mark{
  width:44px; height:44px; border-radius:9px;
  background:linear-gradient(155deg, var(--primary) 0%, var(--primary-light) 100%);
  display:flex; align-items:center; justify-content:center; color:#fff;
  font-family:'Fraunces',serif; font-weight:700; font-size:18px; flex-shrink:0;
}
.page-head .eyebrow{font-size:11px; letter-spacing:.09em; text-transform:uppercase; color:var(--text-muted); font-weight:600; margin-bottom:2px;}
.page-head h1{font-family:'Fraunces',serif; font-weight:600; font-size:24px; color:var(--primary-dark); letter-spacing:-.01em;}

.card{background:var(--surface); border:1px solid var(--border); border-radius:14px; box-shadow:var(--shadow); overflow:hidden;}
.card-body{padding:28px 28px 8px;}
.section-title{
  font-size:11px; text-transform:uppercase; letter-spacing:.07em; font-weight:700; color:var(--primary-light);
  margin:22px 0 12px; padding-top:16px; border-top:1px solid var(--border);
}
.section-title:first-child{margin-top:0; padding-top:0; border-top:none;}

.form-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
.field{display:flex; flex-direction:column; gap:6px; margin-bottom:16px;}
.field.full{grid-column:1/-1;}
.field label{font-size:12.5px; font-weight:600; color:var(--text-muted);}
.field .req{color:var(--rust);}
.field .hint{font-size:11.5px; color:var(--text-faint);}
.field input, .field select, .field textarea{
  padding:10px 12px; border:1px solid var(--border); border-radius:8px; font-size:14px;
  font-family:'Inter',sans-serif; color:var(--text); background:var(--surface-2);
}
.field input:focus, .field select:focus, .field textarea:focus{outline:none; border-color:var(--primary-light); background:#fff;}
.field textarea{resize:vertical; min-height:80px;}
.field .err{font-size:11.5px; color:var(--rust); display:none;}
.field.invalid input, .field.invalid select{border-color:var(--rust); background:var(--rust-bg);}
.field.invalid .err{display:block;}

.card-footer{
  padding:18px 28px; border-top:1px solid var(--border); background:var(--surface-2);
  display:flex; justify-content:flex-end; gap:10px;
}
.btn{
  border:none; border-radius:8px; font-family:'Inter',sans-serif; font-weight:600; font-size:14px;
  cursor:pointer; display:inline-flex; align-items:center; gap:8px; padding:11px 20px;
  transition:transform .12s ease, background .15s ease;
}
.btn:active{transform:translateY(1px);}
.btn-primary{background:var(--primary); color:#fff; box-shadow:0 1px 2px rgba(31,75,63,.15);}
.btn-primary:hover{background:var(--primary-dark);}
.btn-ghost{background:transparent; color:var(--text-muted); border:1px solid var(--border);}
.btn-ghost:hover{border-color:var(--primary-light); color:var(--primary-dark);}

#toast-host{position:fixed; bottom:24px; right:24px; display:flex; flex-direction:column; gap:10px; z-index:200;}
.toast{
  background:var(--primary-dark); color:#fff; padding:12px 18px; border-radius:8px; font-size:13.5px;
  box-shadow:0 8px 32px rgba(28,35,31,.2); font-weight:500;
}
.toast.error{background:var(--rust);}

@media (max-width:700px){ .form-grid{grid-template-columns:1fr;} }
</style>
</head>
<body>
<div class="wrap">
  <a class="back-link" href="AO.html">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    Retour à la liste des appels d'offres
  </a>

  <div class="page-head">
    <div class="head-mark">+</div>
    <div>
      <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
      <h1>Nouvel appel d'offres</h1>
    </div>
  </div>

  <form id="ao-form" novalidate>
    <div class="card">
      <div class="card-body">

        <div class="section-title">Identification</div>
        <div class="form-grid">
          <div class="field full">
            <label>N° de l'appel d'offres <span class="req">*</span></label>
            <input type="text" id="in-numero" placeholder="ex : 12/2026/ORMVASM">
            <span class="err">Le numéro de l'AO est requis.</span>
          </div>
          <div class="field full">
            <label>Objet du marché <span class="req">*</span></label>
            <input type="text" id="in-objet" placeholder="ex : Aménagement du réseau d'irrigation — secteur Ouled Teima">
            <span class="err">L'objet est requis.</span>
          </div>
          <div class="field">
            <label>Type de marché <span class="req">*</span></label>
            <select id="in-type">
              <option value="">Sélectionner…</option>
              <option>Travaux</option><option>Fournitures</option><option>Services</option><option>Études</option>
            </select>
            <span class="err">Choisissez un type.</span>
          </div>
          <div class="field">
            <label>Mode de passation</label>
            <select id="in-mode">
              <option>Appel d'offres ouvert</option>
              <option>Appel d'offres restreint</option>
              <option>Concours</option>
              <option>Bon de commande</option>
            </select>
          </div>
        </div>

        <div class="section-title">Montant et calendrier</div>
        <div class="form-grid">
          <div class="field">
            <label>Montant estimatif (DH) <span class="req">*</span></label>
            <input type="number" id="in-montant" placeholder="0.00" min="0" step="0.01">
            <span class="err">Indiquez un montant valide.</span>
          </div>
          <div class="field">
            <label>Statut initial</label>
            <select id="in-statut">
              <option value="preparation">En préparation</option>
              <option value="publie">Publié</option>
            </select>
            <span class="hint">Les statuts suivants (évaluation, attribution…) se règlent depuis la fiche de modification.</span>
          </div>
          <div class="field">
            <label>Date de publication</label>
            <input type="date" id="in-datePub">
          </div>
          <div class="field">
            <label>Date limite de dépôt des offres <span class="req">*</span></label>
            <input type="date" id="in-dateLimite">
            <span class="err">Cette date est requise.</span>
          </div>
        </div>

        <div class="section-title">Compléments</div>
        <div class="form-grid">
          <div class="field full">
            <label>Observations</label>
            <textarea id="in-obs" placeholder="Notes internes, remarques du bureau…"></textarea>
          </div>
        </div>

      </div>
      <div class="card-footer">
        <a class="btn btn-ghost" href="AO.html">Annuler</a>
        <button type="button" class="btn btn-primary" id="btn-save">Enregistrer l'appel d'offres</button>
      </div>
    </div>
  </form>
</div>

<div id="toast-host"></div>

<script>
const STORAGE_KEY = 'ormvasm_appels_offres';
const seed = [
  {id:1, numero:"07/2026/ORMVASM", objet:"Réhabilitation du réseau d'irrigation goutte-à-goutte — périmètre Chtouka", type:"Travaux", mode:"Appel d'offres ouvert", montant:1850000, datePub:"2026-05-10", dateLimite:"2026-06-15", statut:"attribue", fournisseur:"STE HYDROTECH SARL", obs:""},
  {id:2, numero:"11/2026/ORMVASM", objet:"Fourniture d'équipements de pompage solaire", type:"Fournitures", mode:"Appel d'offres ouvert", montant:620000, datePub:"2026-06-20", dateLimite:"2026-07-25", statut:"evaluation", fournisseur:"", obs:"3 plis reçus, commission prévue le 28/07."},
  {id:3, numero:"14/2026/ORMVASM", objet:"Étude de faisabilité — extension du périmètre irrigué d'Ouled Teima", type:"Études", mode:"Concours", montant:340000, datePub:"2026-07-01", dateLimite:"2026-08-10", statut:"publie", fournisseur:"", obs:""},
  {id:4, numero:"05/2026/ORMVASM", objet:"Maintenance des ouvrages de curage des seguias", type:"Services", mode:"Bon de commande", montant:180000, datePub:"2026-03-05", dateLimite:"2026-04-01", statut:"cloture", fournisseur:"GROUPE AGRISERV", obs:""},
  {id:5, numero:"09/2026/ORMVASM", objet:"Construction d'un bassin de stockage d'eau — secteur Biougra", type:"Travaux", mode:"Appel d'offres ouvert", montant:2400000, datePub:"2026-05-28", dateLimite:"2026-07-05", statut:"infructueux", fournisseur:"", obs:"Aucune offre conforme au cahier des charges."},
  {id:6, numero:"16/2026/ORMVASM", objet:"Acquisition de matériel informatique pour le bureau technique", type:"Fournitures", mode:"Appel d'offres restreint", montant:95000, datePub:"", dateLimite:"2026-08-30", statut:"preparation", fournisseur:"", obs:""},
];
/* Couche de données partagée avec appels-offres.html et modifier-ao.html.
   À remplacer par des appels fetch vers /api/appels-offres quand l'API sera prête. */
const api = {
  _read(){
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw){ localStorage.setItem(STORAGE_KEY, JSON.stringify(seed)); return [...seed]; }
    try{ return JSON.parse(raw); }catch(e){ return [...seed]; }
  },
  _write(list){ localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); },
  async create(ao){
    const list = this._read();
    ao.id = Date.now();
    list.unshift(ao);
    this._write(list);
    return ao;
  }
};

function validateForm(){
  let valid = true;
  const checks = [
    ['in-numero', v => v.trim().length > 0],
    ['in-objet', v => v.trim().length > 0],
    ['in-type', v => v.trim().length > 0],
    ['in-montant', v => v !== '' && Number(v) >= 0],
    ['in-dateLimite', v => v.trim().length > 0],
  ];
  checks.forEach(([id, test]) => {
    const el = document.getElementById(id);
    const field = el.closest('.field');
    if(!test(el.value)){ field.classList.add('invalid'); valid = false; }
    else field.classList.remove('invalid');
  });
  if(!valid){
    document.querySelector('.field.invalid').scrollIntoView({behavior:'smooth', block:'center'});
  }
  return valid;
}

function toast(msg, isError = false){
  const host = document.getElementById('toast-host');
  const el = document.createElement('div');
  el.className = 'toast' + (isError ? ' error' : '');
  el.textContent = msg;
  host.appendChild(el);
  setTimeout(() => el.remove(), 2600);
}

document.getElementById('btn-save').addEventListener('click', async () => {
  if(!validateForm()) return;
  const payload = {
    numero: document.getElementById('in-numero').value.trim(),
    objet: document.getElementById('in-objet').value.trim(),
    type: document.getElementById('in-type').value,
    mode: document.getElementById('in-mode').value,
    montant: Number(document.getElementById('in-montant').value),
    statut: document.getElementById('in-statut').value,
    datePub: document.getElementById('in-datePub').value,
    dateLimite: document.getElementById('in-dateLimite').value,
    fournisseur: "",
    obs: document.getElementById('in-obs').value.trim(),
  };
  try{
    await api.create(payload);
    toast("Appel d'offres créé avec succès. Redirection…");
    setTimeout(() => { window.location.href = 'appels-offres.html'; }, 700);
  }catch(e){
    toast("Une erreur est survenue lors de l'enregistrement.", true);
  }
});
</script>
</body>
</html>