<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Appels d'Offres</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="public/css/liste.css" />
  </head>
  <body>
    <div class="container-fluid">
      <h2 class="page-title">3. APPELS D'OFFRES</h2>

      <div class="card-custom">
        <div class="toolbar">
          <div class="search-box">
            <input
              type="text"
              class="form-control"
              id="searchInput"
              placeholder="🔍 Rechercher un appel d'offres..."
            />
          </div>

          <div>
            <select
              class="form-select d-inline-block me-2"
              id="categorieFilter"
              style="width: 170px"
            >
              <option value="">Toutes catégories</option>
              <option>Travaux</option>
              <option>Services</option>
              <option>Fournitures</option>
            </select>

            <select
              class="form-select d-inline-block me-2"
              id="etatFilter"
              style="width: 170px"
            >
              <option value="">Tous les états</option>
              <option>Ouvert</option>
              <option>En évaluation</option>
              <option>Archivé</option>
            </select>
            <button class="btn btn-primary">+ Nouvel appel d'offres</button>
          </div>
        </div>

        <table class="table align-middle" id="tableBody">
          <thead>
            <tr>
              <th>N°</th>
              <th>Objet</th>
              <th>Catégorie</th>
              <th>État</th>
              <th>Montant estimatif (MAD)</th>
              <th>Date lancement</th>
              <th>Date limite dépôt</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>AO-2025-001</td>
              <td>Travaux de construction...</td>
              <td>Travaux</td>
              <td>
                <span class="status badge-ouvert"> Ouvert </span>
              </td>
              <td>1 250 000,00</td>
              <td>10/05/2025</td>
              <td>25/05/2025</td>
              <td>
                <button class="action-btn">👁</button>
                <button class="action-btn">✏️</button>
              </td>
            </tr>

            <tr>
              <td>AO-2025-002</td>
              <td>Fourniture de matériel...</td>
              <td>Fournitures</td>
              <td>
                <span class="status badge-ouvert"> Ouvert </span>
              </td>
              <td>850 000,00</td>
              <td>11/05/2025</td>
              <td>26/05/2025</td>
              <td>
                <button class="action-btn">👁</button>
                <button class="action-btn">✏️</button>
              </td>
            </tr>

            <tr>
              <td>AO-2025-003</td>
              <td>Prestations de services...</td>
              <td>Services</td>
              <td>
                <span class="status badge-evaluation"> En évaluation </span>
              </td>
              <td>600 000,00</td>
              <td>05/05/2025</td>
              <td>20/05/2025</td>
              <td>
                <button class="action-btn">👁</button>
                <button class="action-btn">✏️</button>
              </td>
            </tr>

            <tr>
              <td>AO-2025-004</td>
              <td>Étude et suivi...</td>
              <td>Services</td>
              <td>
                <span class="status badge-evaluation"> En évaluation </span>
              </td>
              <td>420 000,00</td>
              <td>20/04/2025</td>
              <td>10/05/2025</td>
              <td>
                <button class="action-btn">👁</button>
                <button class="action-btn">✏️</button>
              </td>
            </tr>

            <tr>
              <td>AO-2025-005</td>
              <td>Maintenance équipements...</td>
              <td>Fournitures</td>
              <td>
                <span class="status badge-archive"> Archivé </span>
              </td>
              <td>310 000,00</td>
              <td>18/04/2025</td>
              <td>15/05/2025</td>
              <td>
                <button class="action-btn">👁</button>
                <button class="action-btn">✏️</button>
              </td>
            </tr>
          </tbody>
        </table>

        <nav class="d-flex justify-content-center mt-4">
          <ul class="pagination">
            <li class="page-item active">
              <a class="page-link" href="#">1</a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#">2</a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#">3</a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#">›</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
    <script src="public/js/liste.js"></script>
  </body>
</html>
