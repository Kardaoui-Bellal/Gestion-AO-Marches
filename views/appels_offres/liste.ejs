<%
const _appelsOffres = typeof appelsOffres !== 'undefined' ? appelsOffres : [];
const _currentRoute  = typeof currentRoute !== 'undefined' ? currentRoute : 'appels-offres';
const _utilisateur   = typeof utilisateur !== 'undefined' ? utilisateur : { initiales: 'BI', nom: 'Bureau Informatique' };
%>
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Appels d'offres — ORMVA/SM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\css\AO.css" >
</head>
<body>

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none"><path d="M3 16c3-4 6 4 9 0s6-4 9 0" stroke="#1A140A" stroke-width="2" stroke-linecap="round"/><path d="M3 10c3-4 6 4 9 0s6-4 9 0" stroke="#1A140A" stroke-width="2" stroke-linecap="round" opacity="0.6"/></svg>
      </div>
      <div class="brand-text">
        <strong>ORMVA/SM</strong>
        <span>Bureau Informatique</span>
      </div>
    </div>
    <nav class="mainnav">
      <div class="nav-label">Gestion</div>
      <a class="nav-item <%= _currentRoute === 'referentiels' ? 'active' : '' %>" href="/referentiels">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v4H4zM4 12h16v8H4z"/></svg>
        <span class="label">Référentiels</span>
      </a>
      <a class="nav-item <%= _currentRoute === 'fournisseurs' ? 'active' : '' %>" href="/fournisseurs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c1.5-4 4.5-6 7-6s5.5 2 7 6"/></svg>
        <span class="label">Fournisseurs</span>
      </a>
      <a class="nav-item <%= _currentRoute === 'appels-offres' ? 'active' : '' %>" href="/appels-offres">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg>
        <span class="label">Appels d'offres</span>
      </a>
      <a class="nav-item <%= _currentRoute === 'marches' ? 'active' : '' %>" href="/marches">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10l8-6 8 6v10"/><path d="M9 20v-6h6v6"/></svg>
        <span class="label">Marchés</span>
      </a>
    </nav>
    <div class="sidebar-foot">Souss-Massa · v0.1 (dev)</div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div class="breadcrumb">Gestion &nbsp;/&nbsp; <b>Appels d'offres</b></div>
      <div class="topbar-user">
        <div class="avatar"><%= _utilisateur.initiales %></div>
        <span><%= _utilisateur.nom %></span>
      </div>
    </div>

    <div class="content">
      <div class="page-header">
        <h1>Appels d'offres</h1>
        <p>Enregistrez les appels d'offres, suivez leur état d'avancement, modifiez leurs informations et effectuez des recherches rapides selon différents critères.</p>
      </div>

      <svg class="canal-divider" viewBox="0 0 800 14" preserveAspectRatio="none">
        <path d="M0 7 C 40 0, 80 14, 120 7 S 200 0, 240 7 S 320 14, 360 7 S 440 0, 480 7 S 560 14, 600 7 S 680 0, 720 7 S 780 10, 800 7" fill="none" stroke="#C08A2E" stroke-width="2" opacity="0.55"/>
      </svg>

      <div class="toolbar">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input id="searchInput" type="text" placeholder="Rechercher par référence ou objet…">
        </div>
        <select id="filterStatut" class="filter">
          <option value="">Tous les statuts</option>
          <option value="En cours">En cours</option>
          <option value="Clôturé">Clôturé</option>
          <option value="Attribué">Attribué</option>
          <option value="Infructueux">Infructueux</option>
          <option value="Annulé">Annulé</option>
        </select>
        <select id="filterType" class="filter">
          <option value="">Tous les types</option>
          <option value="Travaux">Travaux</option>
          <option value="Fournitures">Fournitures</option>
          <option value="Services">Services</option>
          <option value="Études">Études</option>
        </select>
        <button class="btn btn-ghost" id="resetBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
          Réinitialiser
        </button>
        <div class="spacer"></div>
        <a class="btn btn-primary" href="/appels-offres/nouveau">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
          Nouvel appel d'offres
        </a>
      </div>

      <div class="result-count" id="resultCount"></div>

      <div class="table-wrap">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th data-key="reference">Référence <span class="arrow"></span></th>
                <th data-key="objet">Objet <span class="arrow"></span></th>
                <th data-key="type">Type <span class="arrow"></span></th>
                <th data-key="datePublication">Publication <span class="arrow"></span></th>
                <th data-key="dateLimite">Date limite <span class="arrow"></span></th>
                <th data-key="budget" style="text-align:right;">Budget estimé <span class="arrow"></span></th>
                <th data-key="statut">Statut <span class="arrow"></span></th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <!-- Rendu initial côté serveur (progressive enhancement) -->
              <% if (_appelsOffres.length === 0) { %>
              <tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-faint);">Aucun appel d'offres enregistré.</td></tr>
              <% } %>
              <% _appelsOffres.forEach(function(r) { %>
              <tr>
                <td><span class="ref"><%= r.reference %></span></td>
                <td class="objet">
                  <div class="objet-title"><%= r.objet %></div>
                  <div class="objet-service"><%= r.service %></div>
                </td>
                <td><span class="type-tag"><%= r.type %></span></td>
                <td><span class="date-mono"><%= new Date(r.datePublication).toLocaleDateString('fr-FR') %></span></td>
                <td><span class="date-mono"><%= new Date(r.dateLimite).toLocaleDateString('fr-FR') %></span></td>
                <td><span class="budget"><%= Number(r.budget).toLocaleString('fr-FR') %> MAD</span></td>
                <td>
                  <%
                    const _badgeClass = {
                      'En cours':'info', 'Clôturé':'neutral', 'Attribué':'success',
                      'Infructueux':'warning', 'Annulé':'danger'
                    }[r.statut] || 'neutral';
                  %>
                  <span class="badge <%= _badgeClass %>"><%= r.statut %></span>
                </td>
                <td>
                  <div class="actions">
                    <a class="icon-btn" title="Voir la fiche" href="/appels-offres/<%= r.reference %>">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                    </a>
                    <a class="icon-btn" title="Modifier" href="/appels-offres/<%= r.reference %>/modifier">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    </a>
                    <button class="icon-btn danger" title="Supprimer" data-action="delete" data-ref="<%= r.reference %>">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16"/><path d="M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div id="emptyState" class="empty-state" style="display:none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <p>Aucun appel d'offres ne correspond à votre recherche.</p>
        </div>
        <div class="pagination">
          <div class="pagination-info" id="paginationInfo"></div>
          <div class="pagination-controls" id="paginationControls"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

<script src="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\js\AO.js">
</script>
</body>
</html>
