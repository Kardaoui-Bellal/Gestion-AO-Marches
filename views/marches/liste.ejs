<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : "Marchés — ORMVA/SM" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/Layout/sidebar.css" />
    <link rel="stylesheet" href="/css/Layout/navbar.css" />
    <link rel="stylesheet" href="/css/Layout/footer.css" />
    <link rel="stylesheet" href="/css/marches.css" />
  </head>
  <body>
    <%
      function fmtDate(v) {
        if (!v) return '—';
        const d = new Date(v);
        if (isNaN(d)) return '—';
        return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
      }
      function fmtMoney(v) {
        if (v === null || v === undefined || v === '') return '—';
        return Number(v).toLocaleString('fr-FR') + ' DH';
      }
      function statutBudgeClass(code) {
        switch (code) {
          case 'NOTIFIE': return 'info';
          case 'EN_COURS': return 'warning';
          case 'SUSPENDU': return 'danger';
          case 'ACHEVE': return 'success';
          case 'RESILIE': return 'danger';
          case 'RENOUVELE': return 'info';
          case 'EXPIRE': return 'neutral';
          default: return 'neutral';
        }
      }
    %>
    <div class="app-shell">
      <%- include('../layouts/partials/sidebar', {
        currentPage: 'marches',
        counts: { appelsOffres: 0, alertes: 0 },
        currentUser: currentUser
      }) %>

      <main class="app-content">
    <div class="wrap">
      <div class="topbar">
        <div class="title-block">
          <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
          <h1 class="page-title">Gestion des Marchés</h1>
        </div>
        <div class="actions-top">
          <a class="btn btn-ghost" href="/export/marches/excel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Exporter Excel
          </a>
          <a class="btn btn-primary" href="/marches/new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            Ajouter un marché
          </a>
        </div>
      </div>

      <div class="toolbar">
        <div class="search-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
          </svg>
          <input type="text" id="searchInput" placeholder="Rechercher par numéro, objet, fournisseur…" />
        </div>

        <select id="filterType">
          <option value="">Tous les types</option>
          <% types.forEach(function(t) { %>
            <option value="<%= t.libelle %>" <%= String(filters.type_marche_id) === String(t.id_ref) ? 'selected' : '' %>><%= t.libelle %></option>
          <% }); %>
        </select>

        <select id="filterStatut">
          <option value="">Tous les statuts</option>
          <% statuts.forEach(function(s) { %>
            <option value="<%= s.libelle %>" <%= String(filters.statut_id) === String(s.id_ref) ? 'selected' : '' %>><%= s.libelle %></option>
          <% }); %>
        </select>

        <div class="divider"></div>
        <button class="btn btn-ghost btn-sm" id="resetBtn" type="button">Réinitialiser</button>
      </div>

      <div class="result-count" id="resultCount"></div>

      <div class="table-card">
        <table>
          <thead>
            <tr>
              <th>N° Marché</th>
              <th>Objet</th>
              <th>Appel d'offres</th>
              <th>Fournisseur</th>
              <th>Montant TTC</th>
              <th>Statut</th>
              <th>Échéance</th>
              <th style="width:150px">Actions</th>
            </tr>
          </thead>
          <tbody id="tableBody">
            <% marches.forEach(function(m) { %>
              <tr
                data-row
                data-type="<%= m.type_marche_libelle %>"
                data-statut="<%= m.statut_libelle %>"
                data-search="<%= (m.numero + ' ' + m.objet + ' ' + (m.fournisseur_nom || '') + ' ' + (m.numero_ao || '')).toLowerCase() %>"
              >
                <td class="numero-mono"><%= m.numero %></td>
                <td class="objet-title"><%= m.objet %></td>
                <td class="ao-tag"><%= m.numero_ao || '—' %></td>
                <td><%= m.fournisseur_nom %></td>
                <td class="montant-cell"><%= fmtMoney(m.montant) %></td>
                <td><span class="badge <%= statutBadgeClass(m.statut_code) %>"><%= m.statut_libelle %></span></td>
                <td><span class="badge-echeance" data-date="<%= m.date_fin %>"></span></td>
                <td>
                  <div class="actions">
                    <a class="icon-btn" href="/marches/<%= m.id_marche %>" title="Détails">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
                      </svg>
                    </a>
                    <a class="icon-btn" href="/marches/<%= m.id_marche %>/edit" title="Modifier">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                      </svg>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <div class="empty-state" id="emptyState">
          <h3>Aucun marché trouvé</h3>
          <p>Ajustez vos critères de recherche ou ajoutez un nouveau marché.</p>
          <a class="btn btn-primary" href="/marches/new">Ajouter un marché</a>
        </div>
      </div>
    </div>
        <%- include('../layouts/partials/footer') %>
      </main>
    </div>

    <div id="toast"></div>
    <script src="/js/marches.js"></script>
  </body>
</html>
