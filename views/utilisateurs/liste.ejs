<!doctype html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : "Utilisateurs — ORMVA/SM" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/Layout/sidebar.css" />
  <link rel="stylesheet" href="/css/Layout/navbar.css" />
  <link rel="stylesheet" href="/css/Layout/footer.css" />
  <link rel="stylesheet" href="/css/fournisseurs.css" />
</head>

<body>
  <%
    const users = typeof utilisateurs !== 'undefined' && utilisateurs ? utilisateurs : [];
    const roles = Array.from(new Set(users.map(function (u) { return u.role_libelle || '—'; })));

    function fmtDate(v) {
      if (!v) return '—';
      const d = new Date(v);
      if (isNaN(d)) return '—';
      return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
    }
  %>

  <div class="app-shell">
    <%- include('../layouts/partials/sidebar', { currentPage: 'parametres', counts: { appelsOffres: 0, alertes: 0 },
      currentUser: currentUser }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', { title: "Gestion des Utilisateurs" , currentUser: currentUser }) %>

          <div class="wrap">
            <div class="topbar">
              <div class="brand-text">
                <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
                <h1>Gestion des Utilisateurs</h1>
              </div>
              <div class="topbar-actions">
                <button class="btn btn-ghost" id="printBtn" type="button">Imprimer</button>
                <a class="btn btn-primary" href="/utilisateurs/new">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                  Nouvel utilisateur
                </a>
              </div>
            </div>

            <div class="toolbar">
              <div class="search-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="text" id="searchInput" placeholder="Rechercher par nom ou email…" />
              </div>

              <select id="filterRole">
                <option value="">Tous les rôles</option>
                <% roles.forEach(function(r) { %>
                  <option value="<%= r %>"><%= r %></option>
                <% }); %>
              </select>

              <div class="divider"></div>
              <button class="btn btn-ghost btn-sm" id="resetBtn" type="button">Réinitialiser</button>
            </div>

            <div class="result-count" id="resultCount"><%= users.length %> utilisateur(s)</div>

            <div class="table-card">
              <table>
                <thead>
                  <tr>
                    <th style="width:70px">ID</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Créé le</th>
                    <th style="width:110px">Statut</th>
                    <th style="width:130px">Actions</th>
                  </tr>
                </thead>
                <tbody id="tableBody">
                  <% users.forEach(function(u) { %>
                    <tr data-row data-role="<%= u.role_libelle || '—' %>"
                      data-search="<%= ((u.nom || '') + ' ' + (u.email || '')).toLowerCase() %>">
                      <td class="id-mono">#<%= u.id_utilisateur %></td>
                      <td>
                        <div class="raison-title"><%= u.nom %></div>
                      </td>
                      <td><%= u.email %></td>
                      <td><span class="type-tag"><%= u.role_libelle || '—' %></span></td>
                      <td><%= fmtDate(u.date_creation) %></td>
                      <td>
                        <% if (u.actif) { %>
                          <span class="badge success">Actif</span>
                        <% } else { %>
                          <span class="badge neutral">Inactif</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="actions">
                          <a class="icon-btn" href="/utilisateurs/<%= u.id_utilisateur %>/edit" title="Modifier">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                            </svg>
                          </a>
                          <a class="icon-btn" href="/utilisateurs/<%= u.id_utilisateur %>/password"
                            title="Changer le mot de passe">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <rect x="3" y="11" width="18" height="11" rx="2" />
                              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>

              <div class="empty-state" id="emptyState" <%= users.length ? 'style="display:none"' : '' %>>
                <h3>Aucun utilisateur trouvé</h3>
                <p>Ajustez vos critères de recherche ou créez un nouveau compte.</p>
                <a class="btn btn-primary" href="/utilisateurs/new">Nouvel utilisateur</a>
              </div>
            </div>
          </div>

          <%- include('../layouts/partials/footer') %>
      </main>
  </div>

  <script>
    (function () {
      const search = document.getElementById('searchInput');
      const filterRole = document.getElementById('filterRole');
      const rows = Array.from(document.querySelectorAll('[data-row]'));
      const empty = document.getElementById('emptyState');
      const count = document.getElementById('resultCount');

      function apply() {
        const q = (search.value || '').trim().toLowerCase();
        const role = filterRole.value;
        let visible = 0;
        rows.forEach(function (r) {
          const ok = (!q || (r.dataset.search || '').includes(q)) && (!role || r.dataset.role === role);
          r.style.display = ok ? '' : 'none';
          if (ok) visible++;
        });
        if (empty) empty.style.display = visible ? 'none' : '';
        if (count) count.textContent = visible + ' utilisateur(s)';
      }

      if (search) search.addEventListener('input', apply);
      if (filterRole) filterRole.addEventListener('change', apply);
      const reset = document.getElementById('resetBtn');
      if (reset) reset.addEventListener('click', function () {
        search.value = ''; filterRole.value = ''; apply();
      });
      const print = document.getElementById('printBtn');
      if (print) print.addEventListener('click', function () { window.print(); });
    })();
  </script>
</body>

</html>
