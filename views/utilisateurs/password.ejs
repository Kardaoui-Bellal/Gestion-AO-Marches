<!doctype html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : "Mot de passe — ORMVA/SM" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/Layout/sidebar.css" />
  <link rel="stylesheet" href="/css/Layout/navbar.css" />
  <link rel="stylesheet" href="/css/Layout/footer.css" />
  <link rel="stylesheet" href="/css/appels-offres-form.css" />
</head>

<body>
  <%
    const u = typeof utilisateur !== 'undefined' && utilisateur ? utilisateur : {};
  %>

  <div class="app-shell">
    <%- include('../layouts/partials/sidebar', { currentPage: 'parametres', currentUser: currentUser }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', { title: "Gestion des Utilisateurs" , currentUser: currentUser }) %>

          <div class="wrap">
            <div class="topbar">
              <div class="brand">
                <div class="brand-mark">MP</div>
                <div class="brand-text">
                  <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
                  <h1>Changer le mot de passe</h1>
                </div>
              </div>
              <a class="btn btn-ghost" href="/utilisateurs">Annuler</a>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert-error"><%= error %></div>
            <% } %>

            <form id="pwdForm" class="form-card" method="POST"
              action="/utilisateurs/<%= u.id_utilisateur %>/password" novalidate>
              <div class="form-grid">
                <div class="field full">
                  <label>Compte concerné</label>
                  <input type="text" value="<%= (u.nom || '') + (u.email ? ' — ' + u.email : '') %>" disabled />
                  <span class="hint">Le nouveau mot de passe remplacera immédiatement l'ancien.</span>
                </div>

                <div class="field">
                  <label for="nouveau_mot_de_passe">Nouveau mot de passe <span class="req">*</span></label>
                  <input type="password" id="nouveau_mot_de_passe" name="nouveau_mot_de_passe"
                    placeholder="8 caractères minimum" minlength="8" required />
                  <span class="err">8 caractères minimum.</span>
                </div>

                <div class="field">
                  <label for="nouveau_mot_de_passe_confirm">Confirmer <span class="req">*</span></label>
                  <input type="password" id="nouveau_mot_de_passe_confirm" name="nouveau_mot_de_passe_confirm"
                    placeholder="Ressaisir le mot de passe" minlength="8" required />
                  <span class="err">Les mots de passe doivent correspondre.</span>
                </div>
              </div>

              <div class="form-footer">
                <a class="btn btn-ghost" href="/utilisateurs">Annuler</a>
                <button type="submit" class="btn btn-primary">Mettre à jour le mot de passe</button>
              </div>
            </form>
          </div>

          <%- include('../layouts/partials/footer') %>
      </main>
  </div>

  <script>
    (function () {
      const form = document.getElementById('pwdForm');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        let ok = true;
        const pwd = document.getElementById('nouveau_mot_de_passe');
        const confirm = document.getElementById('nouveau_mot_de_passe_confirm');

        [pwd, confirm].forEach(function (el) {
          const valid = el.value && el.value.length >= 8;
          el.closest('.field').classList.toggle('invalid', !valid);
          if (!valid) ok = false;
        });

        if (ok && pwd.value !== confirm.value) {
          confirm.closest('.field').classList.add('invalid');
          ok = false;
        }
        if (!ok) e.preventDefault();
      });
    })();
  </script>
</body>

</html>
