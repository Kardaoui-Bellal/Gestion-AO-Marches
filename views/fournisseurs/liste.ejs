<!doctype html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= typeof title !=='undefined' ? title : "Fournisseurs — ORMVA/SM" %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/Layout/sidebar.css" />
  <link rel="stylesheet" href="/css/Layout/navbar.css" />
  <link rel="stylesheet" href="/css/Layout/footer.css" />
  <link rel="stylesheet" href="/css/fournisseurs.css" />
</head>

<body>
  <div class="app-shell">
    <%- include('../layouts/partials/sidebar', { currentPage: 'fournisseurs' , counts: { appelsOffres: 0, alertes: 0 },
      currentUser: currentUser }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', { title: "Gestion des Fournisseurs" , currentUser: currentUser }) %>

          <div class="wrap">
            <div class="topbar">
              <div class="brand-text">
                <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
                <h1>Gestion des Fournisseurs</h1>
              </div>
              <div class="topbar-actions">
                <a class="btn btn-ghost" href="/export/fournisseurs/excel">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                  Exporter Excel
                </a>
                <a class="btn btn-primary" href="/fournisseurs/new"> <svg viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                  Ajouter Fournisseur
                </a>
              </div>
            </div>

            <div class="toolbar">
              <div class="search-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="text" id="searchInput" placeholder="Rechercher par raison sociale, ICE, email…" />
              </div>

              <select id="filterDomaine">
                <option value="">Tous les domaines</option>
                <% domaines.forEach(function(d) { %>
                  <option value="<%= d.libelle %>" <%=(typeof selectedDomaine !=='undefined' &&
                    String(selectedDomaine)===String(d.id_ref)) ? 'selected' : '' %>>
                    <%= d.libelle %>
                  </option>
                  <% }); %>
              </select>

              <div class="divider"></div>
              <button class="btn btn-ghost btn-sm" id="resetBtn" type="button">Réinitialiser</button>
            </div>

            <div class="result-count" id="resultCount"></div>

            <div class="table-card">
              <table>
                <thead>
                  <tr>
                    <th style="width:70px">ID</th>
                    <th>Raison sociale</th>
                    <th>N° ICE</th>
                    <th>Domaine d'activité</th>
                    <th>Téléphone</th>
                    <th>Email</th>
                    <th>Statut</th>
                    <th style="width: 130px">Actions</th>
                  </tr>
                </thead>
                <tbody id="tableBody">
                  <% fournisseurs.forEach(function(f) { %>
                    <tr data-row data-domaine="<%= f.domaine_activite_libelle %>"
                      data-search="<%= (f.raison_sociale + ' ' + f.ice + ' ' + (f.email || '') + ' ' + (f.contact || '')).toLowerCase() %>">
                      <td class="id-mono">#<%= f.id_fournisseur %>
                      </td>
                      <td>
                        <div class="raison-title">
                          <%= f.raison_sociale %>
                        </div>
                        <% if (f.contact) { %>
                          <div class="raison-contact">Contact : <%= f.contact %>
                          </div>
                          <% } %>
                      </td>
                      <td class="ice-mono">
                        <%= f.ice %>
                      </td>
                      <td><span class="type-tag">
                          <%= f.domaine_activite_libelle %>
                        </span></td>
                      <td>
                        <%= f.telephone || '—' %>
                      </td>
                      <td>
                        <%= f.email || '—' %>
                      </td>
                      <td>
                        <% if (f.actif) { %>
                          <span class="badge success">Actif</span>
                          <% } else { %>
                            <span class="badge neutral">Inactif</span>
                            <% } %>
                      </td>
                      <td>
                        <div class="actions">
                          <a class="icon-btn" href="/fournisseurs/<%= f.id_fournisseur %>" title="Détails">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                              <circle cx="12" cy="12" r="3" />
                            </svg>
                          </a>
                          <a class="icon-btn" href="/fournisseurs/<%= f.id_fournisseur %>/edit" title="Modifier">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                            </svg>
                          </a>
                          <form method="POST" action="/fournisseurs/<%= f.id_fournisseur %>/toggle" data-toggle-form
                            data-currently-active="<%= f.actif ? '1' : '0' %>" style="display:inline">
                            <button type="submit" class="icon-btn danger"
                              title="<%= f.actif ? 'Désactiver' : 'Réactiver' %>">
                              <% if (f.actif) { %>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                  stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M3 6h18" />
                                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                                </svg>
                                <% } else { %>
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="1 4 1 10 7 10" />
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                                  </svg>
                                  <% } %>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                </tbody>
              </table>

              <div class="empty-state" id="emptyState">
                <h3>Aucun fournisseur trouvé</h3>
                <p>Ajustez vos critères de recherche ou ajoutez un nouveau fournisseur.</p>
                <a class="btn btn-primary" href="/fournisseurs/new">Ajouter un fournisseur</a>
              </div>
            </div>
          </div>

          <%- include('../layouts/partials/footer') %>
      </main>
  </div>

  <div id="toast"></div>

  <script src="/js/fournisseurs.js"></script>
</body>

</html>