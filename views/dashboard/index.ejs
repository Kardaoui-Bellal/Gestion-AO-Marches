<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : "Tableau de bord — ORMVA/SM" %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Layout partagé (sidebar / navbar / footer) -->
    <link rel="stylesheet" href="/css/Layout/sidebar.css" />
    <link rel="stylesheet" href="/css/Layout/navbar.css" />
    <link rel="stylesheet" href="/css/Layout/footer.css" />

    <!-- CSS propre au tableau de bord -->
    <link rel="stylesheet" href="/css/dashboard.css" />
  </head>

  <body>
    <%
      // ---------------------------------------------------------------
      // Valeurs par défaut : si le contrôleur ne les fournit pas encore,
      // la page reste fonctionnelle (aucune variable "undefined" ne peut
      // faire planter le rendu, contrairement à l'ancienne version).
      // Un futur dashboardController n'aura qu'à passer les mêmes clés
      // avec de vraies données issues de la base.
      // ---------------------------------------------------------------
      const stats = typeof locals.stats !== 'undefined' ? locals.stats : {
        appelsOffres: 35,
        marchesActifs: 18,
        fournisseurs: 52,
        montantEngage: 18450000,
      };

      const miniStats = typeof locals.miniStats !== 'undefined' ? locals.miniStats : {
        enCours: 18,
        echeancesProches: 7,
        expires: 2,
      };

      const evolutionAO = typeof locals.evolutionAO !== 'undefined' ? locals.evolutionAO : {
        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'],
        data: [2, 4, 5, 3, 6, 8, 5, 7, 9, 8, 6, 10],
      };

      const repartitionMarches = typeof locals.repartitionMarches !== 'undefined' ? locals.repartitionMarches : [
        { value: 18, name: 'En cours' },
        { value: 9, name: 'Terminés' },
        { value: 5, name: 'Expirés' },
        { value: 4, name: 'Suspendus' },
      ];

      const budgetAnnuel = typeof locals.budgetAnnuel !== 'undefined' ? locals.budgetAnnuel : {
        labels: ['2021', '2022', '2023', '2024', '2025', '2026'],
        data: [3.2, 4.5, 5.8, 6.7, 7.3, 8.4],
      };

      const repartitionDomaine = typeof locals.repartitionDomaine !== 'undefined' ? locals.repartitionDomaine : [
        { value: 15, name: 'Matériel' },
        { value: 9, name: 'Logiciels' },
        { value: 6, name: 'Maintenance' },
        { value: 4, name: 'Sécurité' },
        { value: 5, name: 'Réseau' },
      ];

      const derniersAO = typeof locals.derniersAO !== 'undefined' ? locals.derniersAO : [
        { id: null, numero: 'AO-2026-001', objet: 'Acquisition de serveurs', date: '12/07/2026', statut: 'Attribué', badge: 'success' },
        { id: null, numero: 'AO-2026-002', objet: 'Firewall Sophos', date: '15/07/2026', statut: 'En cours', badge: 'warning' },
        { id: null, numero: 'AO-2026-003', objet: 'Licences Microsoft', date: '18/07/2026', statut: 'Ouvert', badge: 'info' },
        { id: null, numero: 'AO-2026-004', objet: 'NAS Synology', date: '21/07/2026', statut: 'Clôturé', badge: 'neutral' },
      ];

      const derniersMarches = typeof locals.derniersMarches !== 'undefined' ? locals.derniersMarches : [
        { id: null, numero: 'M-2026-001', fournisseur: 'Dell Maroc', montant: 850000, date: '03/07/2026', statut: 'En cours', badge: 'success' },
        { id: null, numero: 'M-2026-002', fournisseur: 'Oracle', montant: 1420000, date: '08/07/2026', statut: 'Signé', badge: 'info' },
        { id: null, numero: 'M-2026-003', fournisseur: 'HP Maroc', montant: 670000, date: '14/07/2026', statut: 'Préparation', badge: 'warning' },
        { id: null, numero: 'M-2026-004', fournisseur: 'IBM Maroc', montant: 980000, date: '20/07/2026', statut: 'Expiré', badge: 'danger' },
      ];

      const alertes = typeof locals.alertes !== 'undefined' ? locals.alertes : [
        { type: 'danger', titre: 'Marché expiré', detail: 'M-2025-004' },
        { type: 'warning', titre: 'Expire dans 5 jours', detail: 'M-2026-010' },
        { type: 'success', titre: 'Nouveau fournisseur', detail: 'HP Maroc' },
        { type: 'info', titre: 'AO validé', detail: 'AO-2026-011' },
      ];

      const activites = typeof locals.activites !== 'undefined' ? locals.activites : [
        { type: 'success', titre: 'Nouveau marché enregistré', detail: 'Marché M-2026-014 ajouté avec succès.', quand: 'Il y a 5 min' },
        { type: 'info', titre: "Modification d'un appel d'offres", detail: 'AO-2026-003 mis à jour.', quand: 'Il y a 20 min' },
        { type: 'warning', titre: 'Alerte automatique', detail: 'Le marché M-2025-021 expire bientôt.', quand: 'Il y a 1 heure' },
      ];

      function fmtMoney(v) {
        if (v === null || v === undefined || v === '') return '—';
        return Number(v).toLocaleString('fr-FR') + ' DH';
      }

      // currentUser vient normalement de res.locals (middleware global dans
      // app.js). On sécurise quand même l'accès pour éviter tout crash si
      // la vue est rendue en dehors de ce pipeline.
      const safeCurrentUser = typeof currentUser !== 'undefined' ? currentUser : null;
    %>

    <div class="app-shell">
      <%- include('../layouts/partials/sidebar', {
        currentPage: 'dashboard',
        counts: { appelsOffres: stats.appelsOffres, alertes: alertes.length },
        currentUser: safeCurrentUser
      }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', {
          title: 'Tableau de bord',
          currentUser: safeCurrentUser
        }) %>

        <div class="wrap">
          <div class="topbar">
            <div class="title-block">
              <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
              <h1 class="page-title">Tableau de bord</h1>
            </div>
          </div>

          <!-- Cartes statistiques -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <div>
                <h3 data-counter="<%= stats.appelsOffres %>">0</h3>
                <p>Appels d'offres</p>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
              </div>
              <div>
                <h3 data-counter="<%= stats.marchesActifs %>">0</h3>
                <p>Marchés actifs</p>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <h3 data-counter="<%= stats.fournisseurs %>">0</h3>
                <p>Fournisseurs</p>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-icon danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div>
                <h3 class="no-count"><%= fmtMoney(stats.montantEngage) %></h3>
                <p>Montant engagé</p>
              </div>
            </div>
          </div>

          <!-- Graphiques : évolution + répartition -->
          <div class="charts-row">
            <div class="dashboard-card large">
              <div class="card-header-custom">
                <div>
                  <h5>Évolution des appels d'offres</h5>
                  <small>Statistiques mensuelles</small>
                </div>
                <button class="btn btn-ghost btn-sm" id="exportAoChart" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Exporter
                </button>
              </div>
              <div class="card-body">
                <div id="aoChart" class="chart-container"></div>
              </div>
            </div>

            <div class="dashboard-card">
              <div class="card-header-custom">
                <div>
                  <h5>Répartition des marchés</h5>
                  <small>Par statut</small>
                </div>
              </div>
              <div class="card-body">
                <div id="statusChart" class="chart-container small-chart"></div>
              </div>
            </div>
          </div>

          <!-- Graphiques : budget + domaine -->
          <div class="charts-row">
            <div class="dashboard-card half">
              <div class="card-header-custom">
                <div>
                  <h5>Montants des marchés</h5>
                  <small>Budget annuel</small>
                </div>
              </div>
              <div class="card-body">
                <div id="budgetChart" class="chart-container"></div>
              </div>
            </div>

            <div class="dashboard-card half">
              <div class="card-header-custom">
                <div>
                  <h5>Répartition par domaine</h5>
                  <small>Informatique</small>
                </div>
              </div>
              <div class="card-body">
                <div id="domainChart" class="chart-container"></div>
              </div>
            </div>
          </div>

          <!-- Mini cartes -->
          <div class="mini-grid">
            <div class="mini-card success">
              <div>
                <h6>Marchés en cours</h6>
                <h2><%= miniStats.enCours %></h2>
                <span>Suivi actif</span>
              </div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>

            <div class="mini-card warning">
              <div>
                <h6>Échéances proches</h6>
                <h2><%= miniStats.echeancesProches %></h2>
                <span>À surveiller</span>
              </div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/></svg>
            </div>

            <div class="mini-card danger">
              <div>
                <h6>Marchés expirés</h6>
                <h2><%= miniStats.expires %></h2>
                <span>Action requise</span>
              </div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
          </div>

          <!-- Activité récente -->
          <div class="dashboard-card">
            <div class="card-header-custom">
              <div>
                <h5>Activité récente</h5>
                <small>Dernières opérations</small>
              </div>
            </div>
            <div class="activity-list">
              <% activites.forEach(function(a) { %>
                <div class="activity-item">
                  <div class="activity-icon <%= a.type %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
                  </div>
                  <div class="activity-content">
                    <strong><%= a.titre %></strong>
                    <p><%= a.detail %></p>
                  </div>
                  <span><%= a.quand %></span>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- Derniers AO + Alertes -->
          <div class="tables-row">
            <div class="dashboard-card table-col">
              <div class="card-header-custom">
                <div>
                  <h5>Derniers appels d'offres</h5>
                  <small>Liste des appels d'offres récemment ajoutés</small>
                </div>
                <a href="/appels-offres" class="btn btn-primary btn-sm">Voir tout</a>
              </div>
              <div class="table-responsive">
                <table class="dashboard-table">
                  <thead>
                    <tr>
                      <th>N° AO</th>
                      <th>Objet</th>
                      <th>Date</th>
                      <th>Statut</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% derniersAO.forEach(function(ao) { %>
                      <tr>
                        <td class="mono"><%= ao.numero %></td>
                        <td><%= ao.objet %></td>
                        <td><%= ao.date %></td>
                        <td><span class="badge <%= ao.badge %>"><%= ao.statut %></span></td>
                        <td>
                          <a href="<%= ao.id ? '/appels-offres/' + ao.id : '/appels-offres' %>" class="icon-btn" title="Détails">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="dashboard-card">
              <div class="card-header-custom">
                <h5>Alertes</h5>
              </div>
              <div class="alert-list">
                <% alertes.forEach(function(al) { %>
                  <div class="alert-item <%= al.type %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <div>
                      <strong><%= al.titre %></strong>
                      <p><%= al.detail %></p>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Derniers marchés -->
          <div class="dashboard-card">
            <div class="card-header-custom">
              <div>
                <h5>Derniers marchés enregistrés</h5>
                <small>Suivi des marchés informatiques</small>
              </div>
              <a href="/marches" class="btn btn-primary btn-sm">Voir tous</a>
            </div>
            <div class="table-responsive">
              <table class="dashboard-table">
                <thead>
                  <tr>
                    <th>Référence</th>
                    <th>Fournisseur</th>
                    <th>Montant</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% derniersMarches.forEach(function(m) { %>
                    <tr>
                      <td class="mono"><%= m.numero %></td>
                      <td><%= m.fournisseur %></td>
                      <td class="mono"><%= fmtMoney(m.montant) %></td>
                      <td><%= m.date %></td>
                      <td><span class="badge <%= m.badge %>"><%= m.statut %></span></td>
                      <td>
                        <a href="<%= m.id ? '/marches/' + m.id : '/marches' %>" class="icon-btn" title="Détails">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%- include('../layouts/partials/footer') %>
      </main>
    </div>

    <!-- Données injectées côté serveur pour les graphiques -->
    <script>
      window.DASHBOARD_DATA = <%- JSON.stringify({ evolutionAO, repartitionMarches, budgetAnnuel, repartitionDomaine }) %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
    <script src="/js/dashboard.js"></script>
  </body>
</html>
