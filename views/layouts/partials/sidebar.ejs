<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="C:\Users\GAMETECH\Documents\ormvasm-ao-marches\public\css\Layout\sidebar.css">
</head>
<body>
    <%
/**
 * Partial: sidebar.ejs
 * Variables attendues lors du render (avec valeurs par défaut si absentes) :
 *   currentPage   : string  -> id de la page active (ex: 'marches')
 *   counts        : { appelsOffres: number, alertes: number }
 *   currentUser   : { name: string, role: string, initials: string }
 */
const currentPage = typeof locals.currentPage !== 'undefined' ? locals.currentPage : '';
const counts = typeof locals.counts !== 'undefined' ? locals.counts : { appelsOffres: 0, alertes: 0 };
const currentUser = typeof locals.currentUser !== 'undefined' ? locals.currentUser : { name: 'Utilisateur', role: 'Bureau Informatique', initials: 'BI' };

const icons = {
  dashboard: `<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>`,
  fournisseurs: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  appelsOffres: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/>`,
  marches: `<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><path d="M9 9h.01"/><path d="M15 9h.01"/>`,
  piecesJointes: `<path d="M21.44 11.05 12.25 20.24a5.5 5.5 0 0 1-7.78-7.78l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95L9.41 17.42a1.5 1.5 0 0 1-2.12-2.12l8.49-8.49"/>`,
  alertes: `<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>`,
  historique: `<path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><polyline points="12 7 12 12 15 15"/>`,
  parametres: `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>`
};

const menuGroups = [
  {
    label: null,
    items: [
      { id: 'dashboard', href: '/dashboard', label: "Tableau de bord", icon: icons.dashboard }
    ]
  },
  {
    label: 'Gestion',
    items: [
      { id: 'fournisseurs', href: '/fournisseurs', label: "Fournisseurs", icon: icons.fournisseurs },
      { id: 'appels-offres', href: '/appels-offres', label: "Appels d'offres", icon: icons.appelsOffres, badge: counts.appelsOffres, badgeType: 'soft' },
      { id: 'marches', href: '/marches', label: "Marchés", icon: icons.marches },
      { id: 'pieces-jointes', href: '/pieces-jointes', label: "Pièces jointes", icon: icons.piecesJointes }
    ]
  },
  {
    label: 'Suivi',
    items: [
      { id: 'alertes', href: '/alertes', label: "Alertes", icon: icons.alertes, badge: counts.alertes, badgeType: 'danger' },
      { id: 'historique', href: '/historique', label: "Historique", icon: icons.historique }
    ]
  },
  {
    label: 'Système',
    items: [
      { id: 'parametres', href: '/parametres', label: "Paramètres", icon: icons.parametres }
    ]
  }
];
%>

<aside class="sidebar" id="sidebar">
  <div class="sb-toggle" id="sbToggle">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </div>

  <div class="sb-header">
    <div class="sb-mark">OM</div>
    <div class="sb-brand">
      <div class="name">ORMVA/SM</div>
      <div class="sub">Bureau Informatique</div>
    </div>
  </div>

  <nav class="sb-nav">
    <% menuGroups.forEach(function(group) { %>
      <% if (group.label) { %>
        <div class="sb-divider"></div>
        <div class="sb-group-label"><%= group.label %></div>
      <% } %>

      <% group.items.forEach(function(item) { %>
        <a class="sb-item <%= currentPage === item.id ? 'active' : '' %>" href="<%= item.href %>">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- item.icon %></svg>
          <span class="label"><%= item.label %></span>
          <% if (item.badge && item.badge > 0) { %>
            <span class="badge <%= item.badgeType === 'soft' ? 'soft' : '' %>"><%= item.badge %></span>
          <% } %>
        </a>
      <% }); %>
    <% }); %>
  </nav>

  <div class="sb-footer">
    <div class="sb-avatar"><%= currentUser.initials %></div>
    <div class="sb-user">
      <div class="u-name"><%= currentUser.name %></div>
      <div class="u-role"><%= currentUser.role %></div>
    </div>
  </div>
</aside>

<script>
  document.getElementById('sbToggle').addEventListener('click', function () {
    document.getElementById('sidebar').classList.toggle('collapsed');
  });
</script>

</body>
</html>