<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : "Alertes — ORMVA/SM" %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/Layout/sidebar.css" />
    <link rel="stylesheet" href="/css/Layout/navbar.css" />
    <link rel="stylesheet" href="/css/Layout/footer.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/alerte.css" />
  </head>

  <body>
    <%
      const listEcheances = typeof echeancesProches !== 'undefined' ? echeancesProches : [];
      const listExpires = typeof marchesExpires !== 'undefined' ? marchesExpires : [];
      const safeCurrentUser = typeof currentUser !== 'undefined' ? currentUser : null;

      function fmtDate(v) {
        if (!v) return '—';
        const d = new Date(v);
        if (isNaN(d)) return '—';
        return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
      }
    %>

    <div class="app-shell">
      <%- include('../layouts/partials/sidebar', {
        currentPage: 'alertes',
        counts: { appelsOffres: 0, alertes: listEcheances.length + listExpires.length },
        currentUser: safeCurrentUser
      }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', {
          title: 'Alertes',
          currentUser: safeCurrentUser
        }) %>

        <div class="wrap">
          <div class="topbar">
            <div class="title-block">
              <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
              <h1 class="page-title">Alertes</h1>
            </div>
          </div>

          <div class="dashboard-card">
            <div class="card-header-custom">
              <div>
                <h5>Marchés expirés</h5>
                <small>Action requise</small>
              </div>
            </div>
           <div class="range-filter">
            <div class="range-header">
             <h3>Afficher les marchés expirant dans moins de</h3>
                <span id="rangeLabel">45 jours</span>
            </div>
            <input type="range"  id="daysRange" min="0" max="365" value="45" step="1">
           </div>

            <div class="table-responsive">
              <table class="dashboard-table">
                <thead>
                  <tr>
                    <th>Référence</th>
                    <th>Fournisseur</th>
                    <th>Date de fin</th>
                    <th>Statut</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (listExpires.length === 0) { %>
                    <tr><td colspan="5">Aucun marché expiré.</td></tr>
                  <% } %>
                  <% listExpires.forEach(function(m) { %>
                    <tr>
                      <td class="mono"><%= m.numero %></td>
                      <td><%= m.fournisseur_nom %></td>
                      <td><%= fmtDate(m.date_fin) %></td>
                      <td><span class="badge danger"><%= m.statut_libelle %></span></td>
                      <td>
                        <a href="/marches/<%= m.id_marche %>" class="icon-btn" title="Détails">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="dashboard-card">
            <div class="card-header-custom">
              <div>
                <h5>Échéances proches (30 jours)</h5>
                <small>À surveiller</small>
              </div>
            </div>
            <div class="table-responsive">
              <table class="dashboard-table">
                <thead>
                  <tr>
                    <th>Référence</th>
                    <th>Fournisseur</th>
                    <th>Prochaine échéance</th>
                    <th>Statut</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (listEcheances.length === 0) { %>
                    <tr><td colspan="5">Aucune échéance dans les 30 prochains jours.</td></tr>
                  <% } %>
                  <% listEcheances.forEach(function(m) { %>
                    <tr>
                      <td class="mono"><%= m.numero %></td>
                      <td><%= m.fournisseur_nom %></td>
                      <td><%= fmtDate(m.date_prochaine_echeance) %></td>
                      <td><span class="badge warning"><%= m.statut_libelle %></span></td>
                      <td>
                        <a href="/marches/<%= m.id_marche %>" class="icon-btn" title="Détails">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%- include('../layouts/partials/footer') %>
      </main>
    </div>

  <script>
    const range = document.getElementById("daysRange");
const label = document.getElementById("rangeLabel");

const rows = document.querySelectorAll("tbody tr");

function filtrer() {

    const limite = parseInt(range.value);

    label.textContent = limite + " jours";

    const aujourdhui = new Date();

    rows.forEach(row => {

        const dateFin = row.dataset.dateFin;

        if (!dateFin) return;

        const fin = new Date(dateFin);

        const jours = Math.ceil(
            (fin - aujourdhui) / (1000 * 60 * 60 * 24)
        );

        if (jours < 0) {

            // Toujours afficher les marchés expirés
            row.style.display = "";

        } else if (jours <= limite) {

            row.style.display = "";

        } else {

            row.style.display = "none";

        }

    });

}

range.addEventListener("input", filtrer);

filtrer();
  </script>
  </body>
</html>
