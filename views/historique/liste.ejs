<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : "Historique — ORMVA/SM" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/Layout/sidebar.css" />
    <link rel="stylesheet" href="/css/marches.css" />
    <style>
      .action-badge.INSERT, .action-badge.LOGIN { background: var(--success-soft); color: var(--success); }
      .action-badge.UPDATE { background: var(--info-soft); color: var(--info); }
      .action-badge.ARCHIVE, .action-badge.LOGOUT { background: var(--neutral-soft); color: var(--neutral); }
      .action-badge.UPLOAD { background: var(--warning-soft); color: var(--warning); }
      .action-badge.EXPORT { background: var(--info-soft); color: var(--info); }
      .entite-tag { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--ink-muted); }
      .diff-cell { font-size: 12px; color: var(--ink-muted); max-width: 260px; }
      .diff-cell .champ { font-weight: 700; color: var(--ink); }
    </style>
  </head>
  <body>
    <%
      function fmtDateTime(v) {
        if (!v) return '—';
        const d = new Date(v);
        if (isNaN(d)) return '—';
        return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) + ' à ' +
               d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      }
      var f = (typeof filters !== 'undefined') ? filters : { utilisateur_id: '', entite_type: '' };
      var usersList = (typeof utilisateurs !== 'undefined') ? utilisateurs : [];
    %>
    <div class="app-shell">
      <%- include('../layouts/partials/sidebar', {
        currentPage: 'historique',
        counts: { appelsOffres: 0, alertes: 0 },
        currentUser: currentUser
      }) %>

      <main class="app-content">
        <div class="wrap">
          <div class="topbar">
            <div class="title-block">
              <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
              <h1 class="page-title">Historique des actions</h1>
            </div>
          </div>

          <% if (usersList.length > 0) { %>
            <form class="toolbar" method="GET" action="/historique">
              <select name="utilisateur_id" onchange="this.form.submit()">
                <option value="">Tous les utilisateurs</option>
                <% usersList.forEach(function(u) { %>
                  <option value="<%= u.id_utilisateur %>" <%= String(f.utilisateur_id) === String(u.id_utilisateur) ? 'selected' : '' %>><%= u.nom %></option>
                <% }); %>
              </select>

              <select name="entite_type" onchange="this.form.submit()">
                <option value="">Tous les types d'entité</option>
                <% ['APPEL_OFFRE','MARCHE','FOURNISSEUR','UTILISATEUR','REFERENTIEL','OFFRE','CHECKLIST','SESSION'].forEach(function(t) { %>
                  <option value="<%= t %>" <%= f.entite_type === t ? 'selected' : '' %>><%= t %></option>
                <% }); %>
              </select>

              <div class="divider"></div>
              <a class="btn btn-ghost btn-sm" href="/historique">Réinitialiser</a>
            </form>
          <% } %>

          <div class="result-count"><b><%= historique.length %></b> action<%= historique.length !== 1 ? 's' : '' %> enregistrée<%= historique.length !== 1 ? 's' : '' %></div>

          <div class="table-card">
            <table>
              <thead>
                <tr>
                  <th style="width:150px">Date</th>
                  <th style="width:150px">Utilisateur</th>
                  <th style="width:110px">Action</th>
                  <th style="width:140px">Entité</th>
                  <th>Détails</th>
                </tr>
              </thead>
              <tbody>
                <% historique.forEach(function(h) { %>
                  <tr>
                    <td class="mono" style="font-size:12px;"><%= fmtDateTime(h.date_action) %></td>
                    <td><%= h.utilisateur_nom || '—' %></td>
                    <td><span class="badge action-badge <%= h.action %>"><%= h.action %></span></td>
                    <td class="entite-tag"><%= h.entite_type %> #<%= h.entite_id %></td>
                    <td class="diff-cell">
                      <% if (h.champ_modifie) { %>
                        <span class="champ"><%= h.champ_modifie %></span> :
                        <%= h.ancienne_valeur || '—' %> → <%= h.nouvelle_valeur || '—' %>
                      <% } else if (h.details) { %>
                        <%= h.details %>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>

            <% if (historique.length === 0) { %>
              <div class="empty-state" style="display:block">
                <h3>Aucune action enregistrée</h3>
                <p>Le journal d'audit se remplira au fur et à mesure de l'utilisation de l'application.</p>
              </div>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
