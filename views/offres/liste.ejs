<!doctype html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : "Offres — ORMVA/SM" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/Layout/sidebar.css" />
  <link rel="stylesheet" href="/css/Layout/navbar.css" />
  <link rel="stylesheet" href="/css/Layout/footer.css" />
  <link rel="stylesheet" href="/css/fournisseurs.css" />
</head>

<body>
  <%
    const listeOffres = typeof offres !== 'undefined' && offres ? offres : [];
    const ao = typeof appelOffre !== 'undefined' && appelOffre ? appelOffre : null;

    function fmtDate(v) {
      if (!v) return '—';
      const d = new Date(v);
      if (isNaN(d)) return '—';
      return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });
    }
    function fmtMoney(v) {
      if (v === null || v === undefined || v === '') return '—';
      return Number(v).toLocaleString('fr-FR') + ' DH';
    }
    function statutBadgeClass(code) {
      switch (code) {
        case 'RETENUE': return 'success';
        case 'ADMISSIBLE': return 'info';
        case 'REJETEE': return 'danger';
        case 'RECUE': return 'warning';
        default: return 'neutral';
      }
    }
  %>

  <div class="app-shell">
    <%- include('../layouts/partials/sidebar', { currentPage: 'appels-offres', counts: { appelsOffres: 0, alertes: 0 },
      currentUser: currentUser }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', { title: "Offres reçues" , currentUser: currentUser }) %>

          <div class="wrap">
            <div class="topbar">
              <div class="brand-text">
                <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
                <h1><%= ao ? ('Offres — ' + ao.numero_ao) : 'Offres reçues' %></h1>
              </div>
              <div class="topbar-actions">
                <button class="btn btn-ghost" id="printBtn" type="button">Imprimer</button>
                <% if (ao) { %>
                  <a class="btn btn-ghost" href="/appels-offres/<%= ao.id_ao %>">Retour à l'AO</a>
                  <a class="btn btn-primary" href="/appels-offres/<%= ao.id_ao %>/offres/new">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round">
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                    Nouvelle offre
                  </a>
                <% } %>
              </div>
            </div>

            <% if (ao) { %>
              <div class="result-count">
                Objet : <%= ao.objet %> — Montant estimatif : <%= fmtMoney(ao.montant_estimatif) %>
              </div>
            <% } %>

            <div class="toolbar">
              <div class="search-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="text" id="searchInput" placeholder="Rechercher par fournisseur…" />
              </div>
              <div class="divider"></div>
              <button class="btn btn-ghost btn-sm" id="resetBtn" type="button">Réinitialiser</button>
            </div>

            <div class="result-count" id="resultCount"><%= listeOffres.length %> offre(s)</div>

            <div class="table-card">
              <table>
                <thead>
                  <tr>
                    <th style="width:70px">ID</th>
                    <th>Fournisseur</th>
                    <th>Montant proposé</th>
                    <th>Date de soumission</th>
                    <th>Statut</th>
                    <th style="width:130px">Actions</th>
                  </tr>
                </thead>
                <tbody id="tableBody">
                  <% listeOffres.forEach(function(o) { %>
                    <tr data-row data-search="<%= String(o.fournisseur_nom || '').toLowerCase() %>">
                      <td class="id-mono">#<%= o.id_offre %></td>
                      <td>
                        <div class="raison-title"><%= o.fournisseur_nom || '—' %></div>
                      </td>
                      <td class="ice-mono"><%= fmtMoney(o.montant_propose) %></td>
                      <td><%= fmtDate(o.date_soumission) %></td>
                      <td>
                        <span class="badge <%= statutBadgeClass(o.statut_code) %>">
                          <%= o.statut_libelle || '—' %>
                        </span>
                      </td>
                      <td>
                        <div class="actions">
                          <a class="icon-btn" href="/offres/<%= o.id_offre %>/edit" title="Modifier">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                            </svg>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>

              <div class="empty-state" id="emptyState" <%= listeOffres.length ? 'style="display:none"' : '' %>>
                <h3>Aucune offre reçue</h3>
                <p>Les offres soumises par les fournisseurs apparaîtront ici.</p>
                <% if (ao) { %>
                  <a class="btn btn-primary" href="/appels-offres/<%= ao.id_ao %>/offres/new">Ajouter une offre</a>
                <% } %>
              </div>
            </div>
          </div>

          <%- include('../layouts/partials/footer') %>
      </main>
  </div>

  <script>
    (function () {
      const search = document.getElementById('searchInput');
      const rows = Array.from(document.querySelectorAll('[data-row]'));
      const empty = document.getElementById('emptyState');
      const count = document.getElementById('resultCount');

      function apply() {
        const q = (search.value || '').trim().toLowerCase();
        let visible = 0;
        rows.forEach(function (r) {
          const ok = !q || (r.dataset.search || '').includes(q);
          r.style.display = ok ? '' : 'none';
          if (ok) visible++;
        });
        if (empty) empty.style.display = visible ? 'none' : '';
        if (count) count.textContent = visible + ' offre(s)';
      }

      if (search) search.addEventListener('input', apply);
      const reset = document.getElementById('resetBtn');
      if (reset) reset.addEventListener('click', function () { search.value = ''; apply(); });
      const print = document.getElementById('printBtn');
      if (print) print.addEventListener('click', function () { window.print(); });
    })();
  </script>
</body>

</html>
