<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : "Ajouter un document — ORMVA/SM" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/Layout/sidebar.css" />
    <link rel="stylesheet" href="/css/Layout/navbar.css" />
    <link rel="stylesheet" href="/css/Layout/footer.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/fournisseurs.css" />
  </head>
  <body>
    <%
      const entiteLabel = type_entite === 'AO' ? "Appel d'offres" : "Marché";
      const entiteRef = type_entite === 'AO' ? entite.numero_ao : entite.numero;
      const backHref = type_entite === 'AO' ? ('/appels-offres/' + entite_id) : ('/marches/' + entite_id);
    %>
    <div class="app-shell">
      <%- include('../layouts/partials/sidebar', {
        currentPage: 'pieces-jointes',
        counts: { appelsOffres: 0, alertes: 0 },
        currentUser: currentUser
      }) %>

      <main class="app-content">
        <%- include('../layouts/partials/navbar', {
          title: "Ajouter un document",
          currentUser: currentUser
        }) %>

        <div class="wrap">
          <div class="topbar">
            <div class="title-block">
              <div class="eyebrow">ORMVA/SM — Bureau Informatique</div>
              <h1 class="page-title">Ajouter un document</h1>
            </div>
            <a class="btn btn-ghost" href="<%= backHref %>">Annuler</a>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-error"><%= error %></div>
          <% } %>

          <div class="dashboard-card">
            <div class="card-header-custom">
              <div>
                <h5><%= entiteLabel %> — <%= entiteRef %></h5>
                <small>Le document sera rattaché à cette fiche</small>
              </div>
            </div>

            <form method="POST" action="/documents/upload" enctype="multipart/form-data" class="form-card">
              <input type="hidden" name="type_entite" value="<%= type_entite %>" />
              <input type="hidden" name="entite_id" value="<%= entite_id %>" />

              <div class="form-grid">
                <div class="field">
                  <label for="type_document_id">Type de document <span class="req">*</span></label>
                  <select id="type_document_id" name="type_document_id" required>
                    <option value="">Sélectionner…</option>
                    <% typesDocument.forEach(function(td) { %>
                      <option value="<%= td.id_ref %>"><%= td.libelle %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="field">
                  <label for="document">Fichier <span class="req">*</span></label>
                  <input type="file" id="document" name="document" required />
                </div>

                <div class="field full">
                  <label for="observation">Observation</label>
                  <textarea id="observation" name="observation" placeholder="Remarque optionnelle sur ce document"></textarea>
                </div>
              </div>

              <div class="form-footer">
                <a class="btn btn-ghost" href="<%= backHref %>">Annuler</a>
                <button type="submit" class="btn btn-primary">Téléverser le document</button>
              </div>
            </form>
          </div>
        </div>

        <%- include('../layouts/partials/footer') %>
      </main>
    </div>
  </body>
</html>